<Window x:Class="OpenClawDebugger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenClaw Debugger"
        Icon="/OpenClawDebugger;component/Assets/OpenClawDebugger.ico"
        Width="1360" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020"
        Foreground="#E7ECF5"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111A2B"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#253149"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#92A0B7"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#72A7FF"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B2940"/>
            <Setter Property="Foreground" Value="#E7ECF5"/>
            <Setter Property="BorderBrush" Value="#33445F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#263A59"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2765C8"/>
            <Setter Property="BorderBrush" Value="#3B80E8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1524"/>
            <Setter Property="Foreground" Value="#E7ECF5"/>
            <Setter Property="BorderBrush" Value="#33445F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#3B6DB0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0D1524"/>
            <Setter Property="Foreground" Value="#E7ECF5"/>
            <Setter Property="BorderBrush" Value="#253149"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#202B3D"/>
            <Setter Property="VerticalGridLinesBrush" Value="#202B3D"/>
            <Setter Property="RowBackground" Value="#111A2B"/>
            <Setter Property="AlternatingRowBackground" Value="#0F1828"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#172338"/>
            <Setter Property="Foreground" Value="#AFC0D9"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="#253149"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#AFC0D9"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="Background" Value="#111A2B"/>
            <Setter Property="BorderBrush" Value="#253149"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111A2B" BorderBrush="#253149" BorderThickness="1" CornerRadius="12" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="OpenClaw Debugger" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="本地连接 · 只读扫描 · 受控编辑" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#0D1524" BorderBrush="#253149" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionStatusText" Text="尚未连接" Foreground="#AFC0D9" FontSize="12"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="重新扫描" Click="Refresh_Click" IsEnabled="False"/>
                    <Button x:Name="ConnectButton" Content="连接服务器" Style="{StaticResource PrimaryButton}" Click="Connect_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,14,0,8" Background="#111A2B" BorderBrush="#253149">
            <TabItem Header="概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="项目管理台" FontSize="25" FontWeight="SemiBold"/>
                        <TextBlock Text="连接服务器后读取工作区 Markdown 与表情包目录。保存操作会先检查远程版本，并在本机生成加密回滚快照。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,22"/>
                        <UniformGrid Columns="3" Margin="0,0,0,18">
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,12,0">
                                <StackPanel><TextBlock Text="记忆文件" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MemoryCountText" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,12,0">
                                <StackPanel><TextBlock Text="表情包图片" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="StickerCountText" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel><TextBlock Text="本机回滚快照" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SnapshotPathText" Text="—" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border Background="#132039" BorderBrush="#294267" BorderThickness="1" CornerRadius="10" Padding="18">
                            <StackPanel>
                                <TextBlock Text="安全说明" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="连接使用 Windows OpenSSH 当前配置和身份。应用不保存 SSH 私钥、不开放服务器端口，也不读取 OpenClaw 数据库。记忆和贴图元数据只在需要时读取到内存；保存前的原内容以 Windows DPAPI 加密后写入 OpenClaw-Debugger-Private。"
                                           TextWrapping="Wrap" Foreground="#B8C7DC" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="RootPathsText" Text="工作区和贴图库路径将在连接后显示。" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="记忆">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="4,3,4,10">
                                <TextBlock Text="工作区 Markdown" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="MEMORY.md、USER.md 和 memory/*.md" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ListBox x:Name="MemoryFilesList" SelectionChanged="MemoryFilesList_SelectionChanged"
                                     Background="Transparent" BorderThickness="0" Foreground="#E7ECF5"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="MemoryFileTitle" Text="选择左侧文件" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MemoryFileInfo" Text="远程修改时间、大小与哈希将在读取后显示。" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="EditMemoryButton" Content="编辑" Click="EditMemory_Click" IsEnabled="False"/>
                                    <Button x:Name="CancelMemoryButton" Content="取消" Click="CancelMemory_Click" IsEnabled="False"/>
                                    <Button x:Name="SaveMemoryButton" Content="保存" Style="{StaticResource PrimaryButton}" Click="SaveMemory_Click" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="MemoryEditor" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Cascadia Code" FontSize="13" Padding="14" BorderThickness="0"
                                     TextChanged="MemoryEditor_TextChanged"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="表情包">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="2,0,2,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="标签目录" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="逗号分隔标签；保存时同步 catalog.json 和 MANIFEST.md" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button x:Name="SaveStickerButton" Grid.Column="1" Content="保存标签" Style="{StaticResource PrimaryButton}" Click="SaveSticker_Click" IsEnabled="False"/>
                            </Grid>
                            <DataGrid x:Name="StickerGrid" SelectionChanged="StickerGrid_SelectionChanged" IsReadOnly="True"
                                      SelectionMode="Single" SelectionUnit="FullRow" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="75" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="图片文件" Binding="{Binding ImagePath}" Width="190" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="标签（逗号分隔）" Binding="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" Width="*" IsReadOnly="False"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock x:Name="StickerPreviewTitle" Text="贴图预览" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StickerStatusText" Text="连接后读取目录和标签格式。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,10"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                <TextBlock x:Name="StickerPreviewTags" Text="" Foreground="#B8C7DC" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Content="高级编辑原始标签文件" Click="OpenRawStickerFiles_Click" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <Border Background="#0A0F19" BorderBrush="#253149" BorderThickness="1" CornerRadius="8" MinHeight="240">
                                <Image x:Name="StickerPreviewImage" Stretch="Uniform" Margin="8"/>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="26" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="连接与目录" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="应用调用 Windows OpenSSH，并沿用当前用户的 SSH 配置、known_hosts 与身份代理；不会导入或复制私钥。"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,18"/>
                        <TextBlock Text="服务器地址" Margin="0,8,0,5"/>
                        <TextBox x:Name="HostBox"/>
                        <TextBlock Text="SSH 用户名" Margin="0,12,0,5"/>
                        <TextBox x:Name="UsernameBox"/>
                        <TextBlock Text="SSH 端口" Margin="0,12,0,5"/>
                        <TextBox x:Name="PortBox" Width="120" HorizontalAlignment="Left"/>
                        <TextBlock Text="OpenClaw 工作区绝对路径" Margin="0,12,0,5"/>
                        <TextBox x:Name="WorkspaceBox"/>
                        <TextBlock Text="表情包目录绝对路径" Margin="0,12,0,5"/>
                        <TextBox x:Name="StickersBox"/>
                        <TextBlock Text="隐私数据目录（仓库外）" Margin="0,12,0,5"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="打开文件夹" Click="OpenPrivateFolder_Click" Margin="8,0,0,0"/>
                            <TextBox x:Name="PrivatePathBox" IsReadOnly="True"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"/>
                            <Button Content="连接并扫描" Click="Connect_Click"/>
                        </StackPanel>
                        <TextBlock Text="应用直接复用当前 Windows 用户运行 ssh admin@106.14.173.90 时使用的 OpenSSH 身份，不要求选择或输入密钥。主机指纹严格校验；未知或发生变化的主机密钥会被拒绝。"
                                   Foreground="#D2B984" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#111A2B" BorderBrush="#253149" BorderThickness="1" CornerRadius="8" Padding="12,6">
            <TextBlock x:Name="StatusLine" Text="就绪" Foreground="#AFC0D9" VerticalAlignment="Center" FontSize="12"/>
        </Border>
    </Grid>
</Window>